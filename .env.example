NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/madar
JWT_SECRET=replace-with-at-least-32-characters-secret
CLIENT_URL=http://localhost:3000,https://rjrbyjtj-creator.github.io

# Telegram bots — Render only
TELEGRAM_BOT_TOKEN=
TELEGRAM_FILES_BOT_TOKEN=

# Email verification via Google Apps Script — Railway only
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
GOOGLE_APPS_SCRIPT_SECRET=replace-with-a-long-random-secret

OTP_EXPIRES_MINUTES=3
OTP_RESEND_SECONDS=60
BCRYPT_ROUNDS=12
TRUST_PROXY=1

# Two-node API routing
BACKEND_ROLE=render
PEER_BACKEND_URL=https://madar-railway-production.up.railway.app
LOAD_BALANCER_ENABLED=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_LIVE_MODEL=gemini-3.8-live
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
